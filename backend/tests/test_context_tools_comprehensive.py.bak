        result = await tool.execute(location="US", tool_input={})

        # Should have demographic data
        assert result.available is True or result.available is False


# ============================================================================
# SOCIAL SENTIMENT TOOL TESTS
# ============================================================================

class TestSocialSentimentTool:
    """Test social sentiment analysis."""

    async def test_social_sentiment_gathers_reddit(self):
        """Should gather sentiment from Reddit."""
        tool = SocialSentimentTool()
        result = await tool.execute(
            location="Test City",
            tool_input={"query": "coffee"}
        )

        # Should return sentiment in range
        if result.available:
            assert -1 <= result.sentiment <= 1

    async def test_social_sentiment_score_in_range(self):
        """Sentiment score should be -1 to 1."""
        tool = SocialSentimentTool()
        result = await tool.execute(
            location="Test City",
            tool_input={"query": "test"}
        )

        if result.available and hasattr(result, 'sentiment'):
            assert -1 <= result.sentiment <= 1

    async def test_social_sentiment_handles_api_failure(self):
        """API failure should degrade gracefully."""
        with patch("backend.context.tools.social_sentiment.AsyncAnthropic") as mock_anthropic:
            mock_client = AsyncMock()
            mock_anthropic.return_value = mock_client
            mock_client.messages.create = AsyncMock(
                side_effect=Exception("API Error")
            )

            tool = SocialSentimentTool()
            result = await tool.execute(
                location="Test City",
                tool_input={"query": "test"}
            )

            # Should handle gracefully
            assert result.available is False or result.available is True
