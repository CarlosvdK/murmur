class TestGooglePlacesTool:
    """Test Google Places business discovery."""

    @respx.mock
    async def test_google_places_finds_business(self, respx_mock):
        """Should find business location and details."""
        respx_mock.get("https://places.googleapis.com/v1/places:searchText").mock(
            return_value=respx.Response(200, json={
                "places": [
                    {
                        "name": "Coffee Shop",
                        "rating": 4.5,
                        "reviews": [
                            {"text": "Great place", "rating": 5},
                            {"text": "Good coffee", "rating": 4},
                        ]
                    }
                ]
            })
        )

        tool = GooglePlacesTool()
        result = await tool.execute(
            location="Coffee Shop, San Francisco",
            tool_input={}
        )

        assert result.available is True

    @respx.mock
    async def test_google_places_returns_rating(self, respx_mock):
        """Should extract business rating."""
        respx_mock.get("https://places.googleapis.com/v1/places:searchText").mock(
            return_value=respx.Response(200, json={
                "places": [
                    {"name": "Shop", "rating": 4.2}
                ]
            })
        )

        tool = GooglePlacesTool()
        result = await tool.execute(location="Shop", tool_input={})

        assert result.available is True

    @respx.mock
    async def test_google_places_api_failure(self, respx_mock):
        """API failure should degrade gracefully."""
        respx_mock.get("https://places.googleapis.com/v1/places:searchText").mock(
            return_value=respx.Response(500, json={})
        )

        tool = GooglePlacesTool()
        result = await tool.execute(location="Shop", tool_input={})

        assert result.available is False


# ============================================================================
# REVIEW ANALYZER TOOL TESTS
# ============================================================================

class TestReviewAnalyzerTool:
    """Test review synthesis and analysis."""

    async def test_review_analyzer_summarizes_reviews(self):
        """Should synthesize multiple reviews into themes."""
        with patch("backend.context.tools.review_analyzer.AsyncAnthropic") as mock_anthropic:
            mock_client = AsyncMock()
            mock_anthropic.return_value = mock_client
            mock_client.messages.create = AsyncMock(
                return_value=MagicMock(content=[MagicMock(
                    text='{"summary": "Great service but slow", "themes": ["Service quality", "Wait times"]}'
                )])
            )

            tool = ReviewAnalyzerTool()
            result = await tool.execute(
                location="Coffee Shop",
                tool_input={
                    "reviews": [
                        {"text": "Great service", "rating": 5},
                        {"text": "Very slow", "rating": 2},
                    ]
                }
            )

            assert result.available is True

    async def test_review_analyzer_empty_reviews(self):
        """No reviews should return gracefully."""
        tool = ReviewAnalyzerTool()
        result = await tool.execute(
            location="Shop",
            tool_input={"reviews": []}
        )

        # Should handle empty gracefully
        assert result.available is False or result.available is True


