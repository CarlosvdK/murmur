class TestPriceIndexTool:
    """Test price/cost index retrieval."""

    @respx.mock
    async def test_price_index_returns_costs(self, respx_mock):
        """Should return cost/price indices."""
        respx_mock.get("https://api.worldbank.org/v2/country/US/indicator/FP.CPI.TOTL").mock(
            return_value=respx.Response(200, json={
                "data": [
                    {"value": "300.5", "date": "2024"}
                ]
            })
        )

        tool = PriceIndexTool()
        result = await tool.execute(
            location="US",
            tool_input={}
        )

        assert result.available is True or result.available is False

    @respx.mock
    async def test_price_index_handles_unavailable_data(self, respx_mock):
        """Missing data should degrade gracefully."""
        respx_mock.get("https://api.worldbank.org/v2/country/XX/indicator/FP.CPI.TOTL").mock(
            return_value=respx.Response(404, json={})
        )

        tool = PriceIndexTool()
        result = await tool.execute(location="XX", tool_input={})

        assert result.available is False


