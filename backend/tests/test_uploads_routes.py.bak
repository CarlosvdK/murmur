"""Comprehensive tests for file upload and parsing."""
import pytest
from io import BytesIO
from uuid import uuid4
from unittest.mock import AsyncMock, patch, MagicMock

from fastapi.testclient import TestClient
from backend.api.main import app

client = TestClient(app)


class TestUploadCSVSuccess:
    """Test successful CSV upload and parsing."""

    @pytest.mark.asyncio
    async def test_upload_csv_parsing(self):
        """CSV file should be parsed correctly."""
        user_id = str(uuid4())
        business_id = str(uuid4())

        csv_content = b"""name,age,visits,spend
Alice,25,10,500
Bob,35,5,800
Carol,45,20,1200"""

        with patch("backend.auth.dependencies.get_current_user_id") as mock_auth:
            mock_auth.return_value = user_id

            with patch("backend.api.routes.uploads.get_supabase") as mock_db:
                # Mock business lookup
                mock_db.return_value.table.return_value.select.return_value.eq.return_value.single.return_value.execute.return_value = MagicMock(
                    data={"id": business_id, "user_id": user_id}
                )

                # Mock upload insert
                mock_db.return_value.table.return_value.insert.return_value.execute.return_value = MagicMock(
                    data=[{
                        "id": str(uuid4()),
                        "business_id": business_id,
                        "file_name": "customers.csv",
                        "parse_status": "parsed",
                        "parsed_data": {
                            "columns": ["name", "age", "visits", "spend"],
                            "row_count": 3,
                            "sample": [
                                {"name": "Alice", "age": "25"},
                                {"name": "Bob", "age": "35"},
                            ]
                        }
                    }]
                )

                files = {"file": ("customers.csv", BytesIO(csv_content), "text/csv")}
                response = client.post(
                    f"/api/uploads?business_id={business_id}",
                    files=files,
                )

                # Should succeed
                assert response.status_code in [200, 201]

    @pytest.mark.asyncio
    async def test_csv_parse_status_is_parsed(self):
        """Status should be 'parsed' for valid CSV."""
        user_id = str(uuid4())
        business_id = str(uuid4())

        csv_content = b"col1,col2\nval1,val2"

        with patch("backend.auth.dependencies.get_current_user_id") as mock_auth:
            mock_auth.return_value = user_id

            with patch("backend.api.routes.uploads.get_supabase") as mock_db:
                mock_db.return_value.table.return_value.select.return_value.eq.return_value.single.return_value.execute.return_value = MagicMock(
                    data={"id": business_id, "user_id": user_id}
                )

                upload_response = {
                    "id": str(uuid4()),
                    "parse_status": "parsed",
                    "parsed_data": {"columns": ["col1", "col2"], "row_count": 1},
                }

                mock_db.return_value.table.return_value.insert.return_value.execute.return_value = MagicMock(
                    data=[upload_response]
                )

                files = {"file": ("test.csv", BytesIO(csv_content), "text/csv")}
                response = client.post(f"/api/uploads?business_id={business_id}", files=files)

                assert response.status_code in [200, 201]
                assert response.json()["parse_status"] == "parsed"

    @pytest.mark.asyncio
    async def test_csv_row_count_correct(self):
        """Row count should be accurate."""
        user_id = str(uuid4())
        business_id = str(uuid4())

        # 10 rows plus header
        csv_lines = [b"col1,col2"]
        csv_lines.extend([f"val{i},data{i}".encode() for i in range(10)])
        csv_content = b"\n".join(csv_lines)

        with patch("backend.auth.dependencies.get_current_user_id") as mock_auth:
            mock_auth.return_value = user_id

            with patch("backend.api.routes.uploads.get_supabase") as mock_db:
                mock_db.return_value.table.return_value.select.return_value.eq.return_value.single.return_value.execute.return_value = MagicMock(
                    data={"id": business_id, "user_id": user_id}
                )

                mock_db.return_value.table.return_value.insert.return_value.execute.return_value = MagicMock(
                    data=[{
                        "id": str(uuid4()),
                        "parse_status": "parsed",
                        "parsed_data": {"columns": ["col1", "col2"], "row_count": 10},
                    }]
                )

                files = {"file": ("test.csv", BytesIO(csv_content), "text/csv")}
                response = client.post(f"/api/uploads?business_id={business_id}", files=files)

                assert response.status_code in [200, 201]
                assert response.json()["parsed_data"]["row_count"] == 10

    @pytest.mark.asyncio
    async def test_csv_sample_rows_limited(self):
        """Sample should be ≤5 rows."""
        user_id = str(uuid4())
        business_id = str(uuid4())

        csv_content = b"\n".join([
            b"name,age",
            *[f"person{i},{20+i}".encode() for i in range(10)]
        ])

        with patch("backend.auth.dependencies.get_current_user_id") as mock_auth:
            mock_auth.return_value = user_id

            with patch("backend.api.routes.uploads.get_supabase") as mock_db:
                mock_db.return_value.table.return_value.select.return_value.eq.return_value.single.return_value.execute.return_value = MagicMock(
                    data={"id": business_id, "user_id": user_id}
                )

                mock_db.return_value.table.return_value.insert.return_value.execute.return_value = MagicMock(
                    data=[{
                        "id": str(uuid4()),
                        "parse_status": "parsed",
                        "parsed_data": {
                            "columns": ["name", "age"],
                            "row_count": 10,
                            "sample": [{"name": f"person{i}", "age": str(20+i)} for i in range(5)]
                        },
                    }]
                )

                files = {"file": ("test.csv", BytesIO(csv_content), "text/csv")}
                response = client.post(f"/api/uploads?business_id={business_id}", files=files)

                assert response.status_code in [200, 201]
                assert len(response.json()["parsed_data"]["sample"]) <= 5


class TestUploadValidation:
    """Test upload validation."""

    @pytest.mark.asyncio
    async def test_rejects_unsupported_format(self):
        """Non-CSV/text files should be rejected with 400."""
        user_id = str(uuid4())
        business_id = str(uuid4())

        exe_content = b"MZ\x90\x00"  # EXE header

        with patch("backend.auth.dependencies.get_current_user_id") as mock_auth:
            mock_auth.return_value = user_id

            files = {"file": ("virus.exe", BytesIO(exe_content), "application/x-msdownload")}
            response = client.post(f"/api/uploads?business_id={business_id}", files=files)

            assert response.status_code == 400

    @pytest.mark.asyncio
    async def test_rejects_oversized_file(self):
        """Files >10MB should be rejected with 400."""
        user_id = str(uuid4())
        business_id = str(uuid4())

        # Create 11MB file
        oversized_content = b"x" * (11 * 1024 * 1024)

        with patch("backend.auth.dependencies.get_current_user_id") as mock_auth:
            mock_auth.return_value = user_id

            files = {"file": ("huge.csv", BytesIO(oversized_content), "text/csv")}
            response = client.post(f"/api/uploads?business_id={business_id}", files=files)

            assert response.status_code == 400

    @pytest.mark.asyncio
    async def test_rejects_wrong_business_owner(self):
        """User can't upload to business they don't own (404 or 403)."""
        user_id = str(uuid4())
        other_user_id = str(uuid4())
        business_id = str(uuid4())

        csv_content = b"col1,col2\nval1,val2"

        with patch("backend.auth.dependencies.get_current_user_id") as mock_auth:
            mock_auth.return_value = user_id

            with patch("backend.api.routes.uploads.get_supabase") as mock_db:
                # Business belongs to other user
                mock_db.return_value.table.return_value.select.return_value.eq.return_value.single.return_value.execute.return_value = MagicMock(
                    data={"id": business_id, "user_id": other_user_id}
                )

                files = {"file": ("test.csv", BytesIO(csv_content), "text/csv")}
                response = client.post(f"/api/uploads?business_id={business_id}", files=files)

                assert response.status_code in [403, 404]


class TestUploadErrorHandling:
    """Test error handling in uploads."""

    @pytest.mark.asyncio
    async def test_utf8_error_graceful(self):
        """Binary/encoding errors should return 'pending', not 500."""
        user_id = str(uuid4())
        business_id = str(uuid4())

        # Invalid UTF-8
        bad_content = b"\x80\x81\x82\x83"

        with patch("backend.auth.dependencies.get_current_user_id") as mock_auth:
            mock_auth.return_value = user_id

            with patch("backend.api.routes.uploads.get_supabase") as mock_db:
                mock_db.return_value.table.return_value.select.return_value.eq.return_value.single.return_value.execute.return_value = MagicMock(
                    data={"id": business_id, "user_id": user_id}
                )

                # Should return 'pending' status on encoding error
                mock_db.return_value.table.return_value.insert.return_value.execute.return_value = MagicMock(
                    data=[{
                        "id": str(uuid4()),
                        "parse_status": "pending",
                        "parsed_data": None,
                    }]
                )

                files = {"file": ("bad.csv", BytesIO(bad_content), "text/csv")}
                response = client.post(f"/api/uploads?business_id={business_id}", files=files)

                # Should be 400 or 200 (depending on implementation), not 500
                assert response.status_code != 500

    @pytest.mark.asyncio
    async def test_non_csv_parse_status_is_pending(self):
        """Non-CSV files should have parse_status='pending'."""
        user_id = str(uuid4())
        business_id = str(uuid4())

        txt_content = b"Just plain text, not CSV format"

        with patch("backend.auth.dependencies.get_current_user_id") as mock_auth:
            mock_auth.return_value = user_id

            with patch("backend.api.routes.uploads.get_supabase") as mock_db:
                mock_db.return_value.table.return_value.select.return_value.eq.return_value.single.return_value.execute.return_value = MagicMock(
                    data={"id": business_id, "user_id": user_id}
                )

                mock_db.return_value.table.return_value.insert.return_value.execute.return_value = MagicMock(
                    data=[{
                        "id": str(uuid4()),
                        "parse_status": "pending",
                        "parsed_data": None,
                    }]
                )

                files = {"file": ("notes.txt", BytesIO(txt_content), "text/plain")}
                response = client.post(f"/api/uploads?business_id={business_id}", files=files)

                assert response.status_code in [200, 201]
                data = response.json()
                # Should be pending if not CSV
                assert data.get("parse_status") in ["pending", "parsed"]
