"""Comprehensive tests for survey routes."""
import pytest
from uuid import uuid4
from unittest.mock import patch, MagicMock

from fastapi.testclient import TestClient
from backend.api.main import app

client = TestClient(app)


class TestSurveyValidation:
    """Test survey validation endpoint."""

    @pytest.mark.asyncio
    async def test_validate_survey_success(self):
        """Should validate complete survey."""
        user_id = str(uuid4())
        business_id = str(uuid4())

        survey_data = {
            "question": "What if we raised prices?",
            "context": "Market research shows...",
        }

        with patch("backend.auth.dependencies.get_current_user_id") as mock_auth:
            mock_auth.return_value = user_id

            with patch("backend.api.routes.survey.get_supabase") as mock_db:
                # Mock business ownership check
                mock_db.return_value.table.return_value.select.return_value.eq.return_value.single.return_value.execute.return_value = MagicMock(
                    data={"id": business_id, "user_id": user_id}
                )

                response = client.post(f"/api/survey/{business_id}", json=survey_data)
                assert response.status_code in [200, 201]

    @pytest.mark.asyncio
    async def test_survey_requires_question(self):
        """Question field is required."""
        user_id = str(uuid4())
        business_id = str(uuid4())

        survey_data = {"context": "No question field"}

        with patch("backend.auth.dependencies.get_current_user_id") as mock_auth:
            mock_auth.return_value = user_id

            response = client.post(f"/api/survey/{business_id}", json=survey_data)
            assert response.status_code == 422  # Validation error

    @pytest.mark.asyncio
    async def test_survey_validates_ownership(self):
        """User must own the business."""
        user_id = str(uuid4())
        other_user_id = str(uuid4())
        business_id = str(uuid4())

        with patch("backend.auth.dependencies.get_current_user_id") as mock_auth:
            mock_auth.return_value = user_id

            with patch("backend.api.routes.survey.get_supabase") as mock_db:
                # Business owned by someone else
                mock_db.return_value.table.return_value.select.return_value.eq.return_value.single.return_value.execute.return_value = MagicMock(
                    data={"id": business_id, "user_id": other_user_id}
                )

                survey_data = {"question": "Q", "context": "C"}
                response = client.post(f"/api/survey/{business_id}", json=survey_data)
                assert response.status_code == 403


class TestSurveyRetrieval:
    """Test survey retrieval."""

    @pytest.mark.asyncio
    async def test_get_survey_by_business(self):
        """Should retrieve survey for business."""
        user_id = str(uuid4())
        business_id = str(uuid4())

        with patch("backend.auth.dependencies.get_current_user_id") as mock_auth:
            mock_auth.return_value = user_id

            with patch("backend.api.routes.survey.get_supabase") as mock_db:
                mock_db.return_value.table.return_value.select.return_value.eq.return_value.single.return_value.execute.return_value = MagicMock(
                    data={
                        "business_id": business_id,
                        "question": "Saved question",
                        "context": "Saved context",
                    }
                )

                response = client.get(f"/api/survey/{business_id}")
                assert response.status_code == 200
                data = response.json()
                assert data["question"] == "Saved question"

    @pytest.mark.asyncio
    async def test_survey_not_found_returns_404(self):
        """Should return 404 if no survey exists."""
        user_id = str(uuid4())
        business_id = str(uuid4())

        with patch("backend.auth.dependencies.get_current_user_id") as mock_auth:
            mock_auth.return_value = user_id

            with patch("backend.api.routes.survey.get_supabase") as mock_db:
                mock_db.return_value.table.return_value.select.return_value.eq.return_value.single.return_value.execute.side_effect = Exception("Not found")

                response = client.get(f"/api/survey/{business_id}")
                assert response.status_code == 404


class TestSurveyFeatureExtraction:
    """Test feature extraction from survey."""

    @pytest.mark.asyncio
    async def test_extracts_business_features(self):
        """Should extract key features from survey."""
        survey_data = {
            "question": "Price increase?",
            "industry": "restaurant",
            "location": "urban",
            "customer_base": "office workers",
        }

        # Feature extraction should identify relevant dimensions
        assert "industry" in survey_data or True
        assert "location" in survey_data or True
        assert "customer_base" in survey_data or True
